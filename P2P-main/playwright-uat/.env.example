# Application under test (prefer same-origin API: local Express serving client/out)
# Example local: http://localhost:5000
# Example Vite+proxy: http://localhost:3000 (ensure VITE_API_URL points at your API)
BASE_URL=http://localhost:5000

# Optional: API origin if different from BASE_URL (defaults to BASE_URL)
# API_URL=http://localhost:5000

# Role credentials — never commit real passwords
REQUESTER_USERNAME=
REQUESTER_PASSWORD=

L1_USERNAME=
L1_PASSWORD=

L2_USERNAME=
L2_PASSWORD=

CFO_USERNAME=
CFO_PASSWORD=

SCM_BUYER_USERNAME=
SCM_BUYER_PASSWORD=

SCM_MANAGER_USERNAME=
SCM_MANAGER_PASSWORD=

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: user without Create PR menu (Suite I / A12 negative)
NO_CREATE_PR_USERNAME=
NO_CREATE_PR_PASSWORD=

# Optional master defaults used when filling Create PR
# UAT_ENTITY_SEARCH=
# UAT_ITEM_NAME=
# UAT_CATEGORY_NAME=
