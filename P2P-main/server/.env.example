PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=p2p_system
JWT_SECRET=change-this-secret
# Cloud Run + Cloud SQL (preferred): leave DB_HOST unset/unused and set:
# INSTANCE_CONNECTION_NAME=project:region:instance
# Also attach that Cloud SQL instance to the Cloud Run service.
CORS_ORIGIN=https://p2p-backend-645830234926.asia-south1.run.app
APP_URL=https://p2p-backend-645830234926.asia-south1.run.app
PR_NOTIFY_EMAIL=sathishkumar.r@refex.co.in
# SCM Buyer task + mail assignees (comma-separated)
SCM_BUYER_EMAILS=gopikrishnan.p@refex.co.in,satish.manickam@refex.co.in
# Set to false to disable all outbound email
EMAIL_SEND_ENABLED=true
# Gmail / Google Workspace — send as support@refexone.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@refexone.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_EMAIL=support@refexone.com
SMTP_FROM_NAME=P2P Procurement

# WhatsApp (Unfyd Meta HSM)
# Set either to false to disable outbound WhatsApp
WHATSAPP_SEND_ENABLED=true
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://whatsapp.unfyd.com/unfyd-meta-api/api/v1/hsm/send
WHATSAPP_APP_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=workflow_all_application
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_DEFAULT_TO=6382739635
WHATSAPP_NOTIFY_PHONES=6382739635
# true = also send ops CC phones; false = assignee only
WHATSAPP_CC_OPS=false
# true = if assignee has no mobile, use WHATSAPP_DEFAULT_TO
WHATSAPP_FALLBACK_DEFAULT=true

# PO Excel import default status when not specified in request: draft | imported
PO_IMPORT_DEFAULT_STATUS=imported

# Google Cloud Storage — new file uploads go here; existing disk files are unaffected.
# Subdirectories: vendor-kyc/ purchase-orders/ invoices/ rfq-attachments/ signatures/ pr-attachments/
GCS_BUCKET_NAME=p2p-app-storage-master-diorama-489103-u2
# If running outside GCP (local dev), point to a service-account JSON key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# PDF generation (puppeteer-core). Windows/macOS: auto-detects Chrome/Edge.
# Linux / Docker / Cloud Run: image installs google-chrome-stable.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# RefexOne user sync + SSO login
# Service token for GET /users (org admin). Expires periodically — regenerate in RefexOne admin when sync fails.
REFEXONE_API_URL=https://refexone.com/api
REFEXONE_WEB_URL=https://refexone.com
REFEXONE_API_TOKEN=
REFEXONE_LOGIN_ENABLED=true
# Public API / SAML ACS (must be live URL — never localhost on Cloud Run)
API_PUBLIC_URL=https://p2p-backend-645830234926.asia-south1.run.app
REFEXONE_SAML_ACS_URL=https://p2p-backend-645830234926.asia-south1.run.app/api/auth/refexone/saml/acs
REFEXONE_SAML_ENTITY_ID=https://p2p-backend-645830234926.asia-south1.run.app/auth/refexone/saml
# SAML App ID is hardcoded in server/src/services/refexOneSamlService.js
# https://refexone.com/api/saml/bcc7387a-613a-4607-ae97-028fbdf5dd3b/sso?RelayState={return_url}
# HOME / Launch URL for RefexOne SAML App:
# https://p2p-backend-645830234926.asia-south1.run.app/auth/refexone/launch
