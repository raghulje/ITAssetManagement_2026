# =============================================================================
# Refex IT Asset Management — server env (Biogas_MIS style)
# Copy to server/.env and set your port, public domain, and DB credentials.
# Never commit server/.env
# =============================================================================

# --- Server listen (pick a free port on the host / in Docker) ---
PORT=3053
HOST=0.0.0.0
NODE_ENV=production

# Production: Express serves built SPA from ../client/out on the same PORT
# Build first:  cd client && npm ci && npm run build
SERVE_CLIENT=true

# --- Public origin (no hardcoded LAN IPs) ---
# Set to the URL users open after you map domain → this service in the proxy.
# Examples:
#   https://itam.refex.group
#   http://localhost:3053          (local smoke test)
# Public HTTPS URL users open in the browser (NO container port — proxy uses 443).
# Good:  https://asset.refexone.com
# Bad:   https://asset.refexone.com:3053
FRONTEND_URL=https://asset.refexone.com
PUBLIC_APP_URL=https://asset.refexone.com
# CORS allow-list (comma-separated OK). QR + password-reset emails use PUBLIC_APP_URL.
CLIENT_ORIGIN=https://asset.refexone.com

# Only enable when TLS is terminated in front of the app (real HTTPS domain)
FORCE_HTTPS=false

# --- Database ---
# Local / Docker: point DB_HOST at your MySQL host (reachable from the container).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ITAssetManagement_2026
# Wave 1.6 staging clone (migrate this name first; do not migrate the live DB until approved):
# DB_NAME=ITAssetManagement_2026_test
DB_USER=itam
DB_PASSWORD=itam_change_me

# --- Auth ---
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Optional shared key for ITAgent register/sync
# AGENT_API_KEY=

# --- SAML SSO (RefexOne portal as IdP; this app is the SP) ---
# Give RefexOne these SP values (also shown in Settings → General → SAML):
#   Entity ID / Audience : https://asset.refexone.com/saml/sp
#   ACS URL              : https://asset.refexone.com/api/v1/auth/saml/acs
#   Home URL             : https://asset.refexone.com/
#   SLO URL              : https://asset.refexone.com/api/v1/auth/saml/slo
#   Name ID Format       : urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_ENABLED=false
SAML_BUTTON_LABEL=RefexOne SSO
# Optional overrides (default from PUBLIC_APP_URL):
# SAML_SP_ENTITY_ID=https://asset.refexone.com/saml/sp
# SAML_ACS_URL=https://asset.refexone.com/api/v1/auth/saml/acs
# SAML_SLO_URL=https://asset.refexone.com/api/v1/auth/saml/slo
# SAML_HOME_URL=https://asset.refexone.com/
# From RefexOne IdP metadata (required when SAML_ENABLED=true):
# Issuer example: https://refexone.com/api/saml/<uuid>
SAML_IDP_ENTRY_POINT=
SAML_IDP_ISSUER=
SAML_IDP_CERT=
# Kissflow/RefexOne signs the Assertion only — leave response signing off:
SAML_WANT_RESPONSE_SIGNED=false
# SAML_IDP_SLO_URL=
# SAML_AUTO_PROVISION=false


# --- Adrenalin Live HRMS (employee sync) ---
ADRENALIN_BASE_URL=https://refex.myadrenalin.com/JASON_DYNAMIC_API/SHERISHA/V1/JasonBase
ADRENALIN_USERNAME=
ADRENALIN_PASSWORD=
ADRENALIN_COMPANY_ID=SHERISHA
ADRENALIN_SYNC_INTERVAL_MINUTES=0

# --- Email ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply

# EOL / warranty digest (minutes; 1440 = daily; 0 = disabled)
EOL_ALERT_INTERVAL_MINUTES=1440

# --- Maps ---
# Google Maps is used for the asset pin picker (same key as Mobility).
# Enable APIs: Maps JavaScript API, Geocoding API, Places API (New or legacy).
# Restrict the key: HTTP referrers for the browser key; IP for the server key.
# GOOGLE_MAPS_API_KEY=
# Optional browser-only key (defaults to GOOGLE_MAPS_API_KEY):
# GOOGLE_MAPS_BROWSER_KEY=
