{
  "name": "refex-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:inventory": "tsx scripts/seed-inventory-demo.ts",
    "seed:admin-spaces": "tsx scripts/seed-admin-spaces.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "node scripts/run-wave0-tests.mjs",
    "test:backend": "node scripts/run-wave0-tests.mjs",
    "test:wave0": "node scripts/run-wave0-tests.mjs",
    "test:regression": "node scripts/run-wave0-tests.mjs",
    "test:wave1": "node scripts/run-wave1-tests.mjs",
    "test:wave2": "node scripts/run-wave2-tests.mjs",
    "test:wave3": "node scripts/run-wave3-tests.mjs",
    "test:wave3:staging": "node --import tsx scripts/wave3-staging.ts",
    "migrate:wave3:live": "node --import tsx scripts/wave3-apply-live.ts",
    "test:wave4:staging": "node --import tsx scripts/wave4-staging.ts",
    "migrate:wave4:live": "node --import tsx scripts/wave4-apply-live.ts",
    "test:wave22:staging": "node --import tsx scripts/wave22-staging.ts",
    "test:regression:all": "node scripts/run-regression-all.mjs",
    "test:watch": "tsx --test --watch test/wave0/response-contract.test.ts",
    "test:frontend": "node -e \"console.log('Wave 0: frontend component tests deferred (see WAVE0_REGRESSION_HARNESS.md)')\"",
    "build:client": "npm --prefix ../client ci && npm --prefix ../client run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@node-saml/node-saml": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.11.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bwip-js": "^3.2.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.4",
    "typescript": "~5.8.0"
  }
}
